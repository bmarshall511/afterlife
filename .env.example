# --- Required in production ---------------------------------------------------
# Postgres connection string. On Vercel, installing Neon from the Marketplace injects
# DATABASE_URL (POSTGRES_URL is also accepted). Leave empty locally to use embedded PGlite in .data/.
DATABASE_URL=
# Admin password: long random string (e.g. `openssl rand -base64 24`).
ADMIN_PASSWORD=
# Token in the advance tribute link /remember/<token>. Random, 20+ chars (e.g. `openssl rand -hex 16`).
TRIBUTE_INVITE_TOKEN=
# Public base URL used for QR codes and share links, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=

# --- Photo storage ------------------------------------------------------------
# On Vercel, connecting a PRIVATE Blob store sets BLOB_STORE_ID (+ OIDC auth) automatically.
# Outside Vercel, or for a static credential, set BLOB_READ_WRITE_TOKEN. Leave both empty locally
# to store photos in .data/blobs (or BLOBS_DIR).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Optional -----------------------------------------------------------------
# Override the join URL shown in the QR (defaults to PUBLIC_BASE_URL + /join)
PUBLIC_JOIN_URL=
